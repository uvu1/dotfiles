{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(./config/credentials.json)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/credentials)",
      "Read(~/.config/gh/hosts.yml)",
      "Read(~/.codex/auth.json)",
      "Read(~/.claude.json)"
    ]
  },
  "model": "claude-opus-5",
  "effortLevel": "xhigh",
  "tui": "fullscreen",
  "theme": "dark",
  "agentPushNotifEnabled": true
}
